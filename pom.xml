                <copy file="${project.build.directory}/generated-xslt/_Factur-X 1.09 Zugferd 2.5 - 2026 06 10 - FINAL FR/4. FACTUR-X_1.09_XSD_SCHEMATRON_2026-06-10/3. Factur-X_1.09_EN16931/Factur-X_1.09_EN16931.xslt" tofile="${release.resources.dir}/_Factur-X 1.09 Zugferd 2.5 - 2026 06 10 - FINAL FR/4. FACTUR-X_1.09_XSD_SCHEMATRON_2026-06-10/3. Factur-X_1.09_EN16931/_XSLT_EN16931/FACTUR-X_EN16931.xslt" />
