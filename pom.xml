                <copy file="${project.build.directory}/generated-xslt/_Factur-X 1.09 Zugferd 2.5 - 2026 06 10 - FINAL EN/4. FACTUR-X_1.09_XSD_SCHEMATRON_2026-06-10/4. Factur-X_1.09_EXTENDED/FACTUR-X_EXTENDED.xslt" tofile="${release.resources.dir}/_Factur-X 1.09 Zugferd 2.5 - 2026 06 10 - FINAL EN/4. FACTUR-X_1.09_XSD_SCHEMATRON_2026-06-10/4. Factur-X_1.09_EXTENDED/_XSLT_EXTENDED/Factur-X_EXTENDED.xsl" />
                <copy file="${project.build.directory}/generated-xslt/_Factur-X 1.09 Zugferd 2.5 - 2026 06 10 - FINAL FR/4. FACTUR-X_1.09_XSD_SCHEMATRON_2026-06-10/0. Factur-X_1.09_MINIMUM/Factur-X_1.09_MINIMUM.xslt" tofile="${release.resources.dir}/_Factur-X 1.09 Zugferd 2.5 - 2026 06 10 - FINAL FR/4. FACTUR-X_1.09_XSD_SCHEMATRON_2026-06-10/0. Factur-X_1.09_MINIMUM/_XSLT_MINIMUM/FACTUR-X_MINIMUM.xslt" />
