                <copy file="${project.build.directory}/generated-xslt/ZF25_DE/Schema/4_Factur-X_1.09_EXTENDED/FACTUR-X_EXTENDED.xslt" tofile="${release.resources.dir}/ZF25_DE/Schema/4_Factur-X_1.09_EXTENDED/_XSLT_EXTENDED/FACTUR-X_EXTENDED.xslt" />
                <copy file="${project.build.directory}/generated-xslt/ZF25_EN/Schema/0_Factur-X_1.09_MINIMUM/Factur-X_1.09_MINIMUM.xslt" tofile="${release.resources.dir}/ZF25_EN/Schema/0_Factur-X_1.09_MINIMUM/_XSLT_MINIMUM/FACTUR-X_MINIMUM.xslt" />
                <copy file="${project.build.directory}/generated-xslt/ZF25_EN/Schema/1_Factur-X_1.09_BASICWL/Factur-X_1.09_BASICWL.xslt" tofile="${release.resources.dir}/ZF25_EN/Schema/1_Factur-X_1.09_BASICWL/_XSLT_BASIC-WL/FACTUR-X_BASIC-WL.xslt" />
